# Copia este archivo como .env y completa los valores reales.
# .env NO se debe subir a Git ni incluir en imagenes.

# Base de datos Neon (misma para los 4 microservicios).
# Usa la cadena directa (sin -pooler) para DDL y la pooled para consultas.
DATABASE_URL=postgresql://usuario:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://usuario:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Usuario ADMINISTRADOR de auth que prestamos usa para actualizar ejemplares.
CATALOGO_ADMIN_USUARIO_ID=

# URL del microservicio de notificacion vista desde auth.
# En local: http://localhost:8084. En Render: la URL publica del servicio.
NOTIFICACION_URL=http://localhost:8084

# ---- Correo (notificacion) ----
# Recomendado: API HTTP, porque Render Free bloquea los puertos SMTP.
# SendGrid (Twilio): la clave empieza por "SG." (NO es la API Key "SK...").
SENDGRID_API_KEY=
# Brevo: la clave empieza por "xkeysib-". Se usa si no hay SENDGRID_API_KEY.
BREVO_API_KEY=
# Remitente que aparecera en los correos. Debe estar verificado en Brevo
# (Senders & IP -> Senders) o pertenecer a un dominio verificado (SPF/DKIM).
MAIL_FROM=no-reply@biblioteca.local

# SMTP solo se usa si no hay SENDGRID_API_KEY ni BREVO_API_KEY.
# En local puedes apuntar a MailHog (host localhost, puerto 1025).
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
